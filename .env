# LAS VARIABLES DE ENTORNO SE ESCRIBEN EN MAYUSCULA PORQUE SON CONSTANTE-... NO DEBEN HABER ESPACIOS EN NADA
# VARIABLES PARA HACER EL DEBUG ON:
FLASK_DEBUG=1
FLASK_ENV=development
FLASK_APP=app.py

